# Racine de configuration Lombok pour tout le projet.
config.stopBubbling = true

# Annote chaque méthode/constructeur généré (builders, getters/setters, constructeurs...) avec
# @lombok.Generated, reconnu nativement par JaCoCo pour exclure ce code du calcul de couverture :
# le boilerplate Lombok (Employee/Pointage) n'a pas besoin d'un test dédié à chaque accesseur.
lombok.addLombokGeneratedAnnotation = true
